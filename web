<section class="promo" id="destacados"><div class="container"><div class="promo-card"><div><span class="eyebrow"><i></i> ¿Buscas algo especial?</span><h2>Tu próximo favorito puede estar más cerca.</h2><p>¿No encuentras un juego, consola o accesorio? Escríbenos y consulta por disponibilidad, compatibilidad y opciones de entrega.</p></div><a class="btn pink" id="promoWA" href="#contacto">Consultar por WhatsApp ↗</a></div></div></section>
<section class="section contact" id="contacto"><div class="container contact-grid"><div><div class="section-kicker">Estamos para ayudarte</div><h2>¿Te ayudamos a elegir?</h2><p style="color:var(--muted)">Cuéntanos qué producto buscas o qué consola tienes. Te ayudaremos a preparar tu consulta.</p><div class="contact-list"><div class="contact-item"><span>💬</span><div><strong>Atención por WhatsApp</strong><small>Coordina tu consulta y pedido directamente.</small></div></div><div class="contact-item"><span>🎮</span><div><strong>Compatibilidad y detalles</strong><small>Consulta versión, estado, stock y accesorios incluidos.</small></div></div><div class="contact-item"><span>📦</span><div><strong>Entrega por coordinar</strong><small>Confirma opciones y condiciones antes de comprar.</small></div></div></div></div>
<form class="contact-form" id="contactForm"><h3 style="font-size:1.35rem;margin-bottom:0">Envíanos tu consulta</h3><label for="customerName">Tu nombre<input id="customerName" name="name" autocomplete="name" placeholder="¿Cómo te llamas?" required maxlength="80"></label><label for="customerMessage">¿Qué producto buscas?<textarea id="customerMessage" name="message" rows="4" placeholder="Ej. Busco una PS4 Slim con mando…" required maxlength="1000"></textarea></label><button class="btn" type="submit">Preparar mensaje por WhatsApp ↗</button><small style="color:var(--muted)">Se abrirá WhatsApp para que revises y envíes el mensaje.</small></form>
</div></section>
</main>
<footer class="footer"><div class="container footer-row"><div><div class="footer-brand">🦖 GAMES<span>MILAGROS</span></div><div>Tu siguiente nivel empieza aquí.</div></div><div>© <span id="year"></span> GamesMilagros · Perú</div></div></footer>
<a class="float-wa" id="floatingWA" href="#contacto" aria-label="Consultar por WhatsApp" title="Consultar por WhatsApp">✆</a>
<div class="drawer" id="drawer" role="dialog" aria-modal="true" aria-labelledby="cartTitle"><div class="backdrop" id="drawerBackdrop"></div><aside class="drawer-panel"><div class="drawer-head"><h2 id="cartTitle">Tu pedido</h2><button class="close-btn" id="closeCart" aria-label="Cerrar carrito">×</button></div><div class="cart-items" id="cartItems"></div><div class="cart-bottom"><div class="total"><span>Total referencial</span><span id="cartTotal">S/ 0,00</span></div><button class="btn" id="checkout">Continuar por WhatsApp ↗</button><p class="cart-hint">Los precios y la disponibilidad deben confirmarse antes del pago.</p></div></aside></div><div class="toast" id="toast" role="status" aria-live="polite"></div>
<script>
'use strict';
const WHATSAPP_NUMBER='51914480157'; // Confirma que este sea el número comercial correcto.
const PRODUCTS=[
{id:'ps4-slim',name:'PlayStation 4',category:'Consolas',price:900,description:'Consola PlayStation 4 · consulta disponibilidad y detalles.',emoji:'🎮',glow:'#315b74',badge:'Destacado'},
{id:'ps5',name:'PlayStation 5',category:'Consolas',price:2900,description:'Consola PlayStation 5 · consulta disponibilidad y detalles.',emoji:'🕹️',glow:'#3b4e8a',badge:'Consola'},
{id:'god-of-war',name:'God of War Ragnarök para PS5',category:'Videojuegos',price:130,description:'Una aventura épica para PlayStation 5.',emoji:'⚔️',glow:'#74452e',badge:''},
{id:'ea-fc',name:'FC 27',category:'Videojuegos',price:220,description:'Videojuego de fútbol · consulta disponibilidad.',emoji:'⚽',glow:'#1d694c',badge:'Popular'},
{id:'controller',name:'Mando de PS4',category:'Accesorios',price:260,description:'Mando para PlayStation 4 · consulta disponibilidad.',emoji:'🎮',glow:'#315b74',badge:''},
{id:'r36-ultra',name:'Consola R36 Ultra',category:'Retro',price:220,description:'Consola portátil retro para disfrutar tus clásicos.',emoji:'👾',glow:'#9a5c26',badge:'Retro'},
{id:'keyboard',name:'Teclado gamer',category:'Accesorios',price:180,description:'Teclado para tu setup gamer.',emoji:'⌨️',glow:'#57418b',badge:''}
];
const $=id=>document.getElementById(id);
const money=n=>new Intl.NumberFormat('es-PE',{style:'currency',currency:'PEN'}).format(n);
let activeCategory='Todos',cart=[],previousFocus=null,toastTimer;
try{const saved=JSON.parse(localStorage.getItem('gm-cart-v4')||'[]');if(Array.isArray(saved))cart=saved.filter(i=>i&&typeof i.id==='string'&&Number.isInteger(i.qty)&&i.qty>0&&PRODUCTS.some(p=>p.id===i.id)).map(i=>({id:i.id,qty:Math.min(i.qty,99)}));}catch{cart=[];}
function escapeHTML(v){return String(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function waURL(message){return `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`;}
function toast(message){$('toast').textContent=message;$('toast').classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>$('toast').classList.remove('show'),2300);}
function renderProducts(){const q=$('search').value.trim().toLocaleLowerCase('es');let list=PRODUCTS.filter(p=>(activeCategory==='Todos'||p.category===activeCategory)&&`${p.name} ${p.category} ${p.description}`.toLocaleLowerCase('es').includes(q));const sort=$('sort').value;if(sort==='low')list.sort((a,b)=>a.price-b.price);if(sort==='high')list.sort((a,b)=>b.price-a.price);if(sort==='az')list.sort((a,b)=>a.name.localeCompare(b.name,'es'));$('productGrid').innerHTML=list.length?list.map(p=>`<article class="product"><div class="product-image" style="--glow:${p.glow}"><span class="product-emoji" aria-hidden="true">${p.emoji}</span>${p.badge?`<span class="badge">${escapeHTML(p.badge)}</span>`:''}</div><div class="product-body"><span class="product-category">${escapeHTML(p.category)}</span><h3>${escapeHTML(p.name)}</h3><p class="product-desc">${escapeHTML(p.description)}</p><div class="product-bottom"><div><div class="price">${money(p.price)}</div><span class="price-note">Precio en soles</span></div><button class="add-btn" data-add="${p.id}" aria-label="Añadir ${escapeHTML(p.name)} al pedido" title="Añadir al pedido">+</button></div></div></article>`).join(''):'<p class="empty">No encontramos productos con esa búsqueda. Prueba otro nombre o consulta por WhatsApp.</p>';}
function saveCart(){try{localStorage.setItem('gm-cart-v4',JSON.stringify(cart));}catch{}}
function renderCart(){cart=cart.filter(i=>PRODUCTS.some(p=>p.id===i.id)&&Number.isInteger(i.qty)&&i.qty>0);let total=0;const count=cart.reduce((s,i)=>s+i.qty,0);$('cartCount').textContent=count; $('cartCount').setAttribute('aria-label',`${count} artículos en el pedido`);$('cartItems').innerHTML=cart.length?cart.map(i=>{const p=PRODUCTS.find(x=>x.id===i.id);total+=p.price*i.qty;return `<article class="cart-item"><div><h3>${escapeHTML(p.name)}</h3><small>${money(p.price)} por unidad</small><div class="qty"><button data-qty="${p.id}:-1" aria-label="Reducir cantidad">−</button><strong>${i.qty}</strong><button data-qty="${p.id}:1" aria-label="Aumentar cantidad">+</button></div></div><div><div class="cart-price">${money(p.price*i.qty)}</div><button class="remove" data-remove="${p.id}">Eliminar</button></div></article>`;}).join(''):'<div class="cart-empty"><div style="font-size:2.7rem;margin-bottom:12px">🛒</div><strong>Tu pedido está vacío</strong><p>Añade algún producto del catálogo para empezar.</p></div>';$('cartTotal').textContent=money(total);$('checkout').disabled=!cart.length;$('checkout').style.opacity=cart.length?'1':'.55';saveCart();}
function addProduct(id){const p=PRODUCTS.find(x=>x.id===id);if(!p)return;const item=cart.find(i=>i.id===id);if(item){if(item.qty>=99){toast('Has alcanzado el máximo por producto.');return;}item.qty++;}else cart.push({id,qty:1});renderCart();toast(`${p.name} añadido a tu pedido`);}
function openCart(){previousFocus=document.activeElement;$('drawer').classList.add('open');document.body.classList.add('lock');$('closeCart').focus();}
function closeCart(){ $('drawer').classList.remove('open');document.body.classList.remove('lock');if(previousFocus&&previousFocus.focus)previousFocus.focus();}
$('productGrid').addEventListener('click',e=>{const b=e.target.closest('[data-add]');if(b)addProduct(b.dataset.add);});
$('filters').addEventListener('click',e=>{const b=e.target.closest('[data-filter]');if(!b)return;activeCategory=b.dataset.filter;document.querySelectorAll('[data-filter]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));renderProducts();});
document.querySelectorAll('[data-jump]').forEach(b=>b.addEventListener('click',()=>{activeCategory=b.dataset.jump;document.querySelectorAll('[data-filter]').forEach(x=>x.setAttribute('aria-pressed',String(x.dataset.filter===activeCategory)));renderProducts();$('catalogo').scrollIntoView({behavior:'smooth'});}));
$('search').addEventListener('input',renderProducts);$('sort').addEventListener('change',renderProducts);$('openCart').addEventListener('click',openCart);$('closeCart').addEventListener('click',closeCart);$('drawerBackdrop').addEventListener('click',closeCart);
$('cartItems').addEventListener('click',e=>{const q=e.target.closest('[data-qty]'),r=e.target.closest('[data-remove]');if(q){const[id,d]=q.dataset.qty.split(':');const item=cart.find(i=>i.id===id);if(!item)return;item.qty+=Number(d);if(item.qty<=0)cart=cart.filter(i=>i.id!==id);if(item.qty>99)item.qty=99;renderCart();}if(r){cart=cart.filter(i=>i.id!==r.dataset.remove);renderCart();}});
$('checkout').addEventListener('click',()=>{if(!cart.length)return;const lines=cart.map(i=>{const p=PRODUCTS.find(x=>x.id===i.id);return `• ${i.qty} x ${p.name} — ${money(p.price*i.qty)}`;});const total=cart.reduce((s,i)=>s+PRODUCTS.find(p=>p.id===i.id).price*i.qty,0);window.open(waURL(`Hola GamesMilagros, quisiera consultar este pedido:\n\n${lines.join('\n')}\n\nTotal referencial: ${money(total)}\n¿Me confirman disponibilidad, precio final y entrega?`),'_blank','noopener,noreferrer');});
$('contactForm').addEventListener('submit',e=>{e.preventDefault();const n=$('customerName').value.trim(),m=$('customerMessage').value.trim();if(!n||!m){toast('Completa tu nombre y consulta.');return;}window.open(waURL(`Hola GamesMilagros, soy ${n}.\n\nMi consulta: ${m}`),'_blank','noopener,noreferrer');});
$('menuToggle').addEventListener('click',()=>{const nav=$('navLinks'),open=nav.classList.toggle('open');$('menuToggle').setAttribute('aria-expanded',String(open));$('menuToggle').textContent=open?'✕':'☰';});
document.querySelectorAll('#navLinks a').forEach(a=>a.addEventListener('click',()=>{$('navLinks').classList.remove('open');$('menuToggle').setAttribute('aria-expanded','false');$('menuToggle').textContent='☰';}));
document.addEventListener('keydown',e=>{if(e.key==='Escape'){if($('drawer').classList.contains('open'))closeCart();$('navLinks').classList.remove('open');$('menuToggle').setAttribute('aria-expanded','false');$('menuToggle').textContent='☰';}});
$('promoWA').href=waURL('Hola GamesMilagros, quisiera consultar por un producto que no veo en el catálogo.');$('promoWA').target='_blank';$('promoWA').rel='noopener noreferrer';$('floatingWA').href=waURL('Hola GamesMilagros, quisiera consultar por sus productos.');$('floatingWA').target='_blank';$('floatingWA').rel='noopener noreferrer';$('year').textContent=new Date().getFullYear();renderProducts();renderCart();
</script>
</body>
</html>
